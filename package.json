{
  "name": "@hakam-aldeen-kh/blix",
  "version": "0.2.1",
  "description": "Dev-tools panel for React apps — HTTP, Redux, Query and Realtime monitoring.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capture": {
      "types": "./dist/capture/index.d.ts",
      "import": "./dist/capture/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "axios": "*",
    "@reduxjs/toolkit": "*",
    "@tanstack/react-query": "*"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "@reduxjs/toolkit": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hakam-aldeen-Kh/blix.git"
  },
  "license": "UNLICENSED"
}
