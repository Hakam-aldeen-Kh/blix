{
  "name": "@hakam-aldeen-kh/blix",
  "version": "0.13.2",
  "description": "Dev-tools panel for React apps — HTTP, Redux, Query and Realtime monitoring.",
  "keywords": [
    "devtools",
    "dev-tools",
    "debug",
    "debugging",
    "debug-panel",
    "devtools-panel",
    "inspector",
    "monitoring",
    "observability",
    "logging",
    "network-inspector",
    "http",
    "http-logger",
    "request-logger",
    "api-monitor",
    "axios",
    "axios-interceptor",
    "redux",
    "redux-devtools",
    "redux-toolkit",
    "state-inspector",
    "react-query",
    "tanstack-query",
    "query-devtools",
    "websocket",
    "realtime",
    "socket",
    "react",
    "react-devtools",
    "nextjs",
    "typescript",
    "frontend",
    "dx",
    "in-app-devtools"
  ],
  "license": "MIT",
  "author": "Hakam aldeen Alkhadraa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hakam-aldeen-Kh/blix.git"
  },
  "bugs": {
    "url": "https://github.com/Hakam-aldeen-Kh/blix/issues"
  },
  "homepage": "https://blixjs.dev",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capture": {
      "types": "./dist/capture/index.d.ts",
      "import": "./dist/capture/index.js",
      "default": "./dist/capture/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:prod-guard": "node scripts/check-prod-guard.mjs",
    "check:redaction": "node scripts/check-redaction.mjs",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "check:keyboard": "node scripts/check-keyboard.mjs",
    "check:hydration": "node scripts/check-hydration.mjs",
    "check:http": "node scripts/check-http.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:panel": "node scripts/check-panel.mjs",
    "check:official": "node scripts/check-official.mjs",
    "check:adversarial": "node scripts/check-adversarial.mjs",
    "check:linking": "node scripts/check-linking.mjs",
    "check": "pnpm check:prod-guard && pnpm check:redaction && pnpm check:isolation && pnpm check:snippets && pnpm check:keyboard && pnpm check:hydration && pnpm check:http && pnpm check:storage && pnpm check:panel && pnpm check:linking",
    "check:package": "node scripts/check-package.mjs",
    "check:e2e": "node scripts/check-e2e.mjs",
    "check:browser": "pnpm check:official && pnpm check:adversarial && pnpm check:e2e",
    "release:check": "pnpm typecheck && pnpm test && pnpm build && pnpm check && pnpm check:package && pnpm check:browser",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "@reduxjs/toolkit": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "axios": "^1.20.0",
    "esbuild": "0.27.7",
    "jsdom": "^30.1.2",
    "playwright-core": "1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
